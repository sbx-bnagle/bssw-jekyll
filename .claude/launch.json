{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "jekyll",
      "runtimeExecutable": "bundle",
      "runtimeArgs": [
        "exec",
        "jekyll",
        "serve",
        "--port",
        "4000",
        "--host",
        "127.0.0.1"
      ],
      "port": 4000
    },
    {
      "name": "editor",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "editor",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}