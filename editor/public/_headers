# Security headers for the editor (Cloudflare static assets). The editor holds
# GitHub tokens, so: no framing, no referrer (the OAuth code is briefly in the
# URL), and scripts/connections limited to this origin and the GitHub API.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://api.github.com; frame-src https://sbx-bnagle.github.io; frame-ancestors 'none'; base-uri 'none'; form-action 'self' https://github.com
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()
