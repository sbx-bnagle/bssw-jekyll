# Copy to .env.local (git-ignored) and fill in.

# GitHub OAuth App (Settings > Developer settings > OAuth Apps > New):
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:5173/
VITE_GITHUB_CLIENT_ID=
# Server-side only (dev middleware / worker). Never prefix with VITE_.
GITHUB_CLIENT_SECRET=

# Token-exchange endpoint. The dev server provides /api/auth/token;
# in production point this at the deployed worker (worker/auth-worker.js).
VITE_AUTH_URL=/api/auth/token

# Repository the editor saves drafts to, and its default branch.
VITE_CONTENT_REPO=sbx-bnagle/bssw-jekyll
VITE_CONTENT_BRANCH=main

# Site that serves /preview/blog-post (local Jekyll or GitHub Pages).
# Its _config.yml preview_allowed_origins must include this editor's origin.
VITE_SITE_URL=https://sbx-bnagle.github.io/bssw-jekyll
