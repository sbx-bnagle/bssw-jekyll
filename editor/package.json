{
  "name": "bssw-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Markdown editor for BSSw blog contributors (GitHub sign-in, components, live preview).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node test/parity.mjs && node test/sync.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "codemirror": "^6.0.2",
    "js-yaml": "^4.3.2",
    "liquidjs": "^10.30.1",
    "marked": "^14.1.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
